[221.196219, "o", "\r\n\u001b[1;33m# Save the public interface before renaming the package.\u001b[0m\r\n"]
[224.396273, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'afairesi repo inspect > before.json'\u001b[0m\r\n"]
[228.974224, "o", "\r\n\u001b[1;33m# Rename hello to greeter and stage the related metadata changes.\u001b[0m\r\n"]
[232.974291, "o", "\r\n\u001b[1;32m$ afairesi repo mv hello greeter\u001b[0m\r\n"]
[234.82083, "o", "move 'hello' to 'greeter'\r\nupdate '.gitignore'\r\n"]
[237.382963, "o", "\r\n\u001b[1;33m# Compare the staged public interface with the last commit in jd format.\u001b[0m\r\n"]
[242.183054, "o", "\r\n\u001b[1;32m$ afairesi repo inspect diff --cached\u001b[0m\r\n"]
[244.195412, "o", "^ {\"file\":\"/tmp/afairesi-inspect-diff-48k6j4mj/before.json\"}\r\n@ [\"greeter\"]\r\n+ {\"cli\":{\"arguments\":[{\"default\":\"afairesi\",\"names\":[\"name\"],\"nargs\":\"?\"}],\"commands\":{}},\"description\":\"A Python package.\",\"kind\":\"python\",\"tests\":[\"test_fuzz_greeting\",\"test_greeting\"],\"type\":\"package\"}\r\n@ [\"hello\"]\r\n- {\"cli\":{\"arguments\":[{\"default\":\"afairesi\",\"names\":[\"name\"],\"nargs\":\"?\"}],\"commands\":{}},\"description\":\"A Python package.\",\"kind\":\"python\",\"tests\":[\"test_fuzz_greeting\",\"test_greeting\"],\"type\":\"package\"}\r\n"]
[246.769953, "o", "\r\n\u001b[1;33m# Save that structural diff as a patch for the earlier inspection.\u001b[0m\r\n"]
[251.170031, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'afairesi repo inspect diff --cached > interface.jd'\u001b[0m\r\n"]
[256.316918, "o", "\r\n\u001b[1;33m# jd-diff-patch provides jd; apply the diff to the saved interface.\u001b[0m\r\n"]
[260.317007, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'jd -p interface.jd before.json | jless'\u001b[0m\r\n"]
