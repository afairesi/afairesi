[274.086314, "o", "\u001b[?1006l\u001b[?1015l\u001b[?1002l\u001b[?1000l\u001b[?25h\u001b[?1049l"]
[276.589296, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'jd -p interface.jd before.json > patched.json'\u001b[0m\r\n"]
[281.018973, "o", "\r\n\u001b[1;33m# Save a fresh inspection to verify that the patched JSON matches it.\u001b[0m\r\n"]
[285.819052, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'afairesi repo inspect > after.json'\u001b[0m\r\n"]
[290.357224, "o", "\r\n\u001b[1;32m$ jd patched.json after.json\u001b[0m\r\n"]
[294.369067, "o", "\r\n\u001b[1;32m$ rm before.json interface.jd patched.json after.json\u001b[0m\r\n"]
[298.371602, "o", "\r\n\u001b[1;33m# Restore the original package name before continuing.\u001b[0m\r\n"]
[301.371672, "o", "\r\n\u001b[1;32m$ afairesi repo mv greeter hello\u001b[0m\r\n"]
[303.185615, "o", "move 'greeter' to 'hello'\r\nupdate '.gitignore'\r\n"]
[305.762263, "o", "\r\n\u001b[1;33m# Create a disposable Nix package to demonstrate removal.\u001b[0m\r\n"]
[308.962329, "o", "\r\n\u001b[1;32m$ afairesi repo add scratch nix\u001b[0m\r\n"]
[313.120472, "o", "\r\n\u001b[1;33m# Remove the disposable package, including its uncommitted files.\u001b[0m\r\n"]
[316.320566, "o", "\r\n\u001b[1;32m$ afairesi repo rm --force scratch\u001b[0m\r\n"]
[317.943569, "o", "rm 'scratch/default.nix'\r\nupdate '.gitignore'\r\n"]
[320.469651, "o", "\r\n\u001b[1;33m# Prepare example file: unexpected.txt\u001b[0m\r\n"]
[323.469918, "o", "\r\n\u001b[1;33m# Preview cleanup of a file outside the repository's source whitelist.\u001b[0m\r\n"]
[327.469967, "o", "\r\n\u001b[1;32m$ afairesi repo fix --dry-run\u001b[0m\r\n"]
[329.151578, "o", "Would remove unexpected.txt\r\n"]
[331.666137, "o", "\r\n\u001b[1;33m# Apply the previewed cleanup and stage managed changes.\u001b[0m\r\n"]
[334.866201, "o", "\r\n\u001b[1;32m$ afairesi repo fix\u001b[0m\r\n"]
[336.557349, "o", "Removing unexpected.txt\r\n"]
[339.083816, "o", "\r\n\u001b[1;33m# Prepare example file: hello/prm/example.txt\u001b[0m\r\n"]
[342.084039, "o", "\r\n\u001b[1;33m# Prepare example file: hello/tmp/session.txt\u001b[0m\r\n"]
[345.084161, "o", "\r\n\u001b[1;33m# Track supporting files in prm/ while keeping temporary files ignored.\u001b[0m\r\n"]
[349.084195, "o", "\r\n\u001b[1;32m$ afairesi repo fix\u001b[0m\r\n"]
[350.730523, "o", "write '.gitignore'\r\n"]
[350.738775, "o", "stage 'hello/prm/example.txt'\r\n"]
[353.269202, "o", "\r\n\u001b[1;32m$ git check-ignore hello/tmp/session.txt\u001b[0m\r\n"]
[354.770873, "o", "hello/tmp/session.txt\r\n"]
[357.272289, "o", "\r\n\u001b[1;32m$ nix fmt\u001b[0m\r\n"]
[358.824562, "o", "warning: Git tree '/home/pbizopoulos/github.com/afairesi/afairesi/demo/tmp/afairesi-demo-h02kjr0r/repositories/toolbox' is dirty\r\n"]
[362.856489, "o", "traversed 7 files\r\nemitted 4 files for processing\r\nformatted 0 files (0 changed) in 17ms\r\n"]
[365.360339, "o", "\r\n\u001b[1;32m$ git add .\u001b[0m\r\n"]
[369.364647, "o", "\r\n\u001b[1;32m$ git commit -m 'Add supporting package data'\u001b[0m\r\n"]
[370.873108, "o", "[main 11b3f51] Add supporting package data\r\n"]
[370.873317, "o", " 2 files changed, 3 insertions(+)\r\n"]
[370.873376, "o", " create mode 100644 hello/prm/example.txt\r\n"]
