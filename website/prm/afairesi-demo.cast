[92.694655, "o", "\r\n\u001b[1;33m# Inspect package interfaces and test names without running their code.\u001b[0m\r\n"]
[96.694721, "o", "\r\n\u001b[1;32m$ afairesi repo inspect\u001b[0m\r\n"]
[98.617428, "o", "{\r\n  \"hello\": {\r\n    \"type\": \"package\",\r\n    \"kind\": \"python\",\r\n    \"description\": \"A Python package.\",\r\n    \"cli\": {\r\n      \"arguments\": [\r\n        {\r\n          \"names\": [\r\n            \"name\"\r\n          ],\r\n          \"nargs\": \"?\",\r\n          \"default\": \"afairesi\"\r\n        }\r\n      ],\r\n      \"commands\": {}\r\n    },\r\n    \"tests\": [\r\n      \"test_fuzz_greeting\",\r\n      \"test_greeting\"\r\n    ]\r\n  }\r\n}\r\n"]
[104.440512, "o", "\r\n\u001b[1;33m# Browse the JSON interface with jless; expand with l, quit with q.\u001b[0m\r\n"]
[109.240584, "o", "\r\n\u001b[1;32m$ bash -o pipefail -c 'afairesi repo inspect | jless'\u001b[0m\r\n"]
[111.260725, "o", "\u001b[?1049h\u001b[?25l\u001b[?1000h\u001b[?1002h\u001b[?1015h\u001b[?1006h\u001b[1;1H\u001b[0m\u001b[2K\u001b[0m\u001b[38;5;3m 1\u001b[0m ▼ \u001b[38;5;8m(1) \u001b[39m\u001b[2m{hello: {type: \"package\", kind: \"python\", description: \"A Python package.\", cli: {…}, …}}\u001b[2;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 2\u001b[0m   ▽ \u001b[38;5;12mhello\u001b[39m: \u001b[38;5;8m(5) \u001b[39m\u001b[2m{type: \"package\", kind: \"python\", description: \"A Python package.\", cli: {…}, …}\u001b[3;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 3\u001b[0m       \u001b[38;5;12mtype\u001b[39m: \u001b[38;5;2m\"package\"\u001b[4;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 4\u001b[0m       \u001b[38;5;12mkind\u001b[39m: \u001b[38;5;2m\"python\"\u001b[5;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 5\u001b[0m       \u001b[38;5;12mdescription\u001b[39m: \u001b[38;5;2m\"A Python package.\"\u001b[6;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 6\u001b[0m     ▽ \u001b[38;5;12mcli\u001b[39m: \u001b[38;5;8m(2) \u001b[39m\u001b[2m{arguments: […], commands: {}}\u001b[7;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 7\u001b[0m       ▽ \u001b[38;5;12marguments\u001b[39m: \u001b[38;5;8m(1) \u001b[39m\u001b[2m[{names: […], nargs: \"?\", default: \"afairesi\"}]\u001b[8;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 8\u001b[0m         ▽ \u001b[2m[0]\u001b[22m: \u001b[38;5;8m(3) \u001b[39m\u001b[2m{names: […], nargs: \"?\", default: \"afairesi\"}\u001b[9;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m 9\u001b[0m           ▽ \u001b[38;5;12mnames\u001b[39m: \u001b[38;5;8m(1) \u001b[39m\u001b[2m[\"name\"]\u001b[10;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m10\u001b[0m               \u001b[2m[0]\u001b[22m: \u001b[38;5;2m\"name\"\u001b[11;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m12\u001b[0m             \u001b[38;5;12mnargs\u001b[39m: \u001b[38;5;2m\"?\"\u001b[12;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m13\u001b[0m             \u001b[38;5;12mdefault\u001b[39m: \u001b[38;5;2m\"afairesi\"\u001b[13;1H\u001b[0m\u001b[2K\u001b[0m\u001b[2m16\u0