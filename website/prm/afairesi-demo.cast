[0.000236, "o", "\r\n\u001b[1;33m# afairesi — real commands in disposable sample repositories\u001b[0m\r\n"]
[3.200283, "o", "\r\n\u001b[1;33m# Explore the two command groups: home and repo.\u001b[0m\r\n"]
[6.400316, "o", "\r\n\u001b[1;32m$ afairesi --help\u001b[0m\r\n"]
[8.034749, "o", "usage: afairesi [-h] SCOPE ...\r\n\r\nCreate and maintain repositories, packages, and hosts in the afairesi computing environment.\r\n\r\noptions:\r\n  -h, --help  show this help message and exit\r\n\r\nscopes:\r\n  SCOPE\r\n    home      manage the home repository and its submodules\r\n    repo      manage Nix flake packages, hosts, checks, and tests\r\n"]
